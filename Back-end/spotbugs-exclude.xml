<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated mappers, configuration, context, entities, repositories, security, and DTOs from SpotBugs inspection -->
    <Match>
        <Package name="~com\.swp\.drug_use_prevention_support_system\.(domain|mappers|config|context|exception|security|repositories).*" />
    </Match>

    <!-- Baseline exclusions for pre-existing legacy issues to establish clean baseline gating -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION_EXCEPTION_EDGE"/>
    </Match>
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
    </Match>
    <Match>
        <Bug pattern="UC_USELESS_CONDITION"/>
    </Match>
</FindBugsFilter>
